          "verification": {
            "status": "pass",
            "recordId": "Pb.uses.0"
          }
        },
        {
          "value": "Lead is used to make lead-acid storage batteries, such as those found in automobiles.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/82#section=Uses",
            "retrieved": "2026-11-14",
