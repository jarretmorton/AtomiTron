          },
          "verification": {
            "status": "pass",
            "recordId": "Pb.uses.1"
          }
        },
        {
          "value": "Lead is used as a covering on some wires and cables to protect them from corrosion.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/82#section=Uses",
            "retrieved": "2026-11-14",
