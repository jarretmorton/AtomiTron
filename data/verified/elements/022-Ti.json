      "uses": [
        {
          "value": "Because titanium does not react within the human body, it is used to make implants such as artificial hips and pins for setting bones.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/22#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Ti.uses.0"
          }
        },
        {
          "value": "Titanium oxide is used as a pigment to make white paint.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/22#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Ti.uses.1"
          }
        },
        {
          "value": "Titanium is used in parts of boats that are exposed to sea water, such as propeller shafts and rigging.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/22#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Ti.uses.2"
          }
        },
        {
          "value": "Titanium and titanium alloys are used in airplanes, among other things.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/22#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
