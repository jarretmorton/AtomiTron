      "discovery": {
        "story": [
          {
            "value": "Titanium was discovered in 1791 by the Reverend William Gregor, an English pastor.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/22#section=History",
              "retrieved": "2026-11-14",
              "via": "Jefferson Lab"
            },
            "verification": {
              "status": "pass",
              "recordId": "Ti.discovery.story.0"
            }
          },
          {
            "value": "The name titanium comes from the Latin titans, the first sons of the Earth in Greek mythology.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/22#section=History",
              "retrieved": "2026-11-14",
              "via": "Los Alamos National Laboratory"
            },
            "verification": {
              "status": "pass",
              "recordId": "Ti.discovery.story.1"
            }
          },
          {
            "value": "In 1795, the German chemist Martin Heinrich Klaproth rediscovered the element and called it titanium.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/22#section=History",
