      "uses": [
        {
          "value": "Samarium, along with other rare earth elements, is used in carbon-arc lighting for the motion picture industry.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/62#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Los Alamos National Laboratory"
          },
          "verification": {
            "status": "pass",
            "recordId": "Sm.uses.0"
          }
        },
        {
          "value": "Samarium forms a compound with cobalt that is a powerful permanent magnet.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/62#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Sm.uses.1"
          }
        },
        {
          "value": "Samarium oxide has been used in optical glass to absorb infrared.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/62#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Los Alamos National Laboratory"
          },
          "verification": {
            "status": "pass",
            "recordId": "Sm.uses.2"
          }
        },
        {
          "value": "Samarium is part of misch metal, a material used to make flints for lighters.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/62#section=Uses",
            "retrieved": "2026-11-14",
