      "discovery": {
        "story": [
          {
            "value": "Samarium is named after the mineral samarskite, which was named for Colonel Samarski, a Russian mine official.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/62#section=History",
              "retrieved": "2026-11-14",
              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Sm.discovery.story.0"
            }
          },
          {
            "value": "Samarium was originally discovered in 1878 by the Swiss chemist Marc Delafontaine, who called it decipium.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/62#section=History",
              "retrieved": "2026-11-14",
              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Sm.discovery.story.1"
            }
          },
          {
            "value": "The French chemist Paul-Émile Lecoq de Boisbaudran was the first to isolate samarium from the mineral samarskite.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/62#section=History",
