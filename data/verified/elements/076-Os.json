      "uses": [
        {
          "value": "Osmium is mainly used to make very hard alloys.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/76#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Os.uses.0"
          }
        },
        {
          "value": "Osmium alloys are found in items such as ball point pen tips, fountain pen tips and record player needles.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/76#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Os.uses.1"
          }
        },
        {
          "value": "Osmium is combined with other platinum group metals to make very hard alloys for items such as fountain pen tips and electrical contacts.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/76#section=Uses",
            "retrieved": "2026-11-14",
