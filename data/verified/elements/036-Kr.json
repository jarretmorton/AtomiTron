              "status": "pass",
              "recordId": "Kr.discovery.story.0"
            }
          },
          {
            "value": "Krypton was discovered in 1898 by Scottish chemist William Ramsay and English chemist Morris Travers while they were studying liquefied air.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/36#section=History",
              "retrieved": "2026-11-14",
              "via": "Jefferson Lab"
            },
            "verification": {
              "status": "pass",
              "recordId": "Kr.discovery.story.1"
            }
          },
          {
            "value": "Ramsay and Travers found krypton in what was left after liquid air had nearly boiled away.",
            "unit": null,
            "uncertain": false,
