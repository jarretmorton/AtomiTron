      "discovery": {
        "story": [
          {
            "value": "Krypton's name comes from the Greek word kryptos, meaning hidden.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/36#section=History",
