      "discovery": {
        "story": [
          {
            "value": "The name hafnium comes from hafnia, the Latin word for Copenhagen.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/72#section=History",
              "retrieved": "2026-11-14",
