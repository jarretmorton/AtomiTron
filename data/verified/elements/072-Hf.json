            },
            "verification": {
              "status": "pass",
              "recordId": "Hf.discovery.story.0"
            }
          },
          {
            "value": "Niels Bohr argued that hafnium would not be a rare earth element, but would be found in zirconium ore.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/72#section=History",
              "retrieved": "2026-11-14",
              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Hf.discovery.story.1"
            }
          },
          {
            "value": "Dirk Coster and George von Hevesy discovered hafnium in 1923, while working at Bohr's Institute in Copenhagen.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/72#section=History",
