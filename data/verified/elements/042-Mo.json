              "recordId": "Mo.discovery.story.0"
            }
          },
          {
            "value": "The name molybdenum comes from the Greek word molybdos, which means \"lead\".",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/42#section=History",
