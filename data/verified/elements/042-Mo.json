              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Mo.discovery.story.1"
            }
          },
          {
            "value": "In ancient times, people used the word \"lead\" for any black mineral that leaves a mark on paper.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/42#section=History",
