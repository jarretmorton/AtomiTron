      "uses": [
        {
          "value": "Very pure antimony is used to make some semiconductor devices, such as diodes and infrared detectors.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/51#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Sb.uses.0"
          }
        },
        {
          "value": "Antimony is alloyed with lead to make the lead more durable.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/51#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Sb.uses.1"
          }
        },
        {
          "value": "Antimony alloys are used in products including batteries and cable sheathing.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/51#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Sb.uses.2"
          }
        },
        {
          "value": "Antimony compounds are used to make products such as paints, glass and pottery.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/51#section=Uses",
            "retrieved": "2026-11-14",
