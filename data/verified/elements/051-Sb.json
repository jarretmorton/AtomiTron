      "discovery": {
        "story": [
          {
            "value": "The name antimony comes from the Greek words anti and monos, meaning \"not alone\" or \"not one\", because it was found in many compounds.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/51#section=History",
              "retrieved": "2026-11-14",
              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Sb.discovery.story.0"
            }
          },
          {
            "value": "The symbol Sb comes from stibium, from the Greek stibi meaning \"mark\", because it was used for blackening eyebrows and eyelashes.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/51#section=History",
              "retrieved": "2026-11-14",
              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Sb.discovery.story.1"
            }
          },
          {
            "value": "Nicolas Lémery, a French chemist, was the first person to scientifically study antimony and its compounds.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/51#section=History",
