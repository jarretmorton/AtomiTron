      "uses": [
        {
          "value": "Erbium is added to fiber optic cables, where it is used as a signal amplifier.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/68#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Er.uses.0"
          }
        },
        {
          "value": "Erbia, a pink compound of erbium, is used to color glass and glazes.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/68#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Er.uses.1"
          }
        },
        {
          "value": "Erbium is alloyed with vanadium to make it softer and easier to shape.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/68#section=Uses",
            "retrieved": "2026-11-14",
