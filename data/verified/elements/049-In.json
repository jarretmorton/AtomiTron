      "uses": [
        {
          "value": "Indium is used with germanium to make transistors.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/49#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "In.uses.0"
          }
        },
        {
          "value": "Indium can be used to make mirrors that reflect as well as silver mirrors but do not tarnish as quickly.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/49#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "In.uses.1"
          }
        },
        {
          "value": "Indium is used to coat the bearings of high speed motors.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/49#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "In.uses.2"
          }
        },
        {
          "value": "Indium is used to make electrical components such as rectifiers, thermistors and photoconductors.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/49#section=Uses",
            "retrieved": "2026-11-14",
