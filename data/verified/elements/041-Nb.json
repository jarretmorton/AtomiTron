      "uses": [
        {
          "value": "Niobium is commonly used to make jewelry.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/41#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Los Alamos National Laboratory"
          },
          "verification": {
            "status": "pass",
            "recordId": "Nb.uses.0"
          }
        },
        {
          "value": "An alloy of niobium and titanium can be made into superconductive wire, which is used to make superconductive magnets.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/41#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Nb.uses.1"
          }
        },
        {
          "value": "Superconductive niobium cavities are at the heart of a machine built at the Thomas Jefferson National Accelerator Facility.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/41#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Jefferson Lab"
          },
          "verification": {
            "status": "pass",
            "recordId": "Nb.uses.2"
          }
        },
        {
          "value": "Niobium is used in arc-welding rods for some kinds of stainless steel.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/41#section=Uses",
            "retrieved": "2026-11-14",
            "via": "Los Alamos National Laboratory"
          },
          "verification": {
            "status": "pass",
            "recordId": "Nb.uses.3"
          }
        }
      ],
      "discovery": {
        "story": [
          {
            "value": "The name niobium comes from Niobe, a character in Greek myths who was the daughter of Tantalus.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/41#section=History",
              "retrieved": "2026-11-14",
              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Nb.discovery.story.0"
            }
          },
          {
            "value": "The British chemist Charles Hatchett discovered niobium in 1801 in a black mineral from America called columbite.",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/41#section=History",
              "retrieved": "2026-11-14",
              "via": "IUPAC CIAAW"
            },
            "verification": {
              "status": "pass",
              "recordId": "Nb.discovery.story.1"
            }
          },
          {
            "value": "Hatchett gave the new element the name columbium.",
            "unit": null,
            "uncertain": false,
            "source": {
