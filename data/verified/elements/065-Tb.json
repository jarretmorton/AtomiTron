          },
          "verification": {
            "status": "pass",
            "recordId": "Tb.uses.1"
          }
        },
        {
          "value": "A terbium compound called sodium terbium borate is used to make laser light.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/65#section=Uses",
