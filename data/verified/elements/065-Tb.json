          "verification": {
            "status": "pass",
            "recordId": "Tb.uses.0"
          }
        },
        {
          "value": "Terbium is used with zirconium dioxide as a crystal stabilizer in fuel cells that operate at high temperatures.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/65#section=Uses",
