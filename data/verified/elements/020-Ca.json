      "uses": [
        {
          "value": "Calcium carbonate, a compound of calcium, is used to make things such as white paint, toothpaste and stomach antacids.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/20#section=Uses",
