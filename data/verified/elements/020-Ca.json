          "verification": {
            "status": "pass",
            "recordId": "Ca.uses.0"
          }
        },
        {
          "value": "Calcium sulfate, also called gypsum, is used to make dry wall and plaster of Paris.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/20#section=Uses",
            "retrieved": "2026-11-14",
