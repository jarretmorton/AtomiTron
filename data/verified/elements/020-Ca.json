          },
          "verification": {
            "status": "pass",
            "recordId": "Ca.uses.1"
          }
        },
        {
          "value": "Calcium is used in vacuum tubes as a getter, a material that removes trace gases.",
          "unit": null,
          "uncertain": false,
          "source": {
            "url": "https://pubchem.ncbi.nlm.nih.gov/element/20#section=Uses",
            "retrieved": "2026-11-14",
