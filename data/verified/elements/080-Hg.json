            }
          },
          {
            "value": "The symbol Hg comes from the Greek word hydrargyrum, meaning \"liquid silver\" or \"quick silver\".",
            "unit": null,
            "uncertain": false,
            "source": {
              "url": "https://pubchem.ncbi.nlm.nih.gov/element/80#section=History",
