{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atomitron:schema:open-question",
  "title": "OpenQuestion",
  "description": "A real unsolved problem, attached to the elements, compounds and reactions it involves (spec 3.6). Every claim is a sourced Fact, including the claim that the question is still open.",
  "type": "object",
  "required": ["id", "title", "links", "isOpen", "known", "unknown", "ideas", "hypothesisPrompt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^oq-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "description": "Short heading, e.g. \"Metallic hydrogen\".", "type": "string", "minLength": 1 },
    "links": {
      "description": "Entity pages that show the \"Nobody knows yet\" marker for this question.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:atomitron:schema:fact#/$defs/entityId" }
    },
    "isOpen": {
      "description": "Sourced statement that the question is unresolved.",
      "$ref": "urn:atomitron:schema:fact"
    },
    "known": { "type": "array", "minItems": 1, "items": { "$ref": "urn:atomitron:schema:fact" } },
    "unknown": { "type": "array", "minItems": 1, "items": { "$ref": "urn:atomitron:schema:fact" } },
    "ideas": {
      "description": "Competing explanations.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "summary": { "$ref": "urn:atomitron:schema:fact" }
        }
      }
    },
    "hypothesisPrompt": {
      "description": "Invites him to write his own hypothesis into the journal. A question, not a claim, so it carries no source.",
      "type": "string",
      "minLength": 1
    }
  }
}
