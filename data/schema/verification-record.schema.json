{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atomitron:schema:verification-record",
  "title": "VerificationRecord",
  "description": "Per-fact verification record (spec 6.1, 10.4b), published in verification/records/. A fact in data/verified/ points at one of these by recordId.",
  "type": "object",
  "required": [
    "id",
    "subject",
    "method",
    "claimedValue",
    "unit",
    "sourceUrl",
    "retrievedValue",
    "result",
    "checkedAt",
    "consistency",
    "verifier"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "subject": {
      "type": "object",
      "required": [
        "entity",
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "description": "Entity ID, an open question ID (oq-...), or an explanation sentence (concept:<key>, app/src/content/concepts.ts).",
          "anyOf": [
            {
              "$ref": "urn:atomitron:schema:fact#/$defs/entityId"
            },
            {
              "type": "string",
              "pattern": "^oq-[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "string",
              "pattern": "^concept:[A-Za-z]+$"
            }
          ]
        },
        "field": {
          "description": "JSON Pointer to the fact inside the entity, e.g. \"/meltingPoint\".",
          "type": "string",
          "pattern": "^(/[^/]+)+$"
        }
      }
    },
    "method": {
      "description": "extract: read by code from the source's structured data. agent: judged by verifier agents (text claims). derive: recomputed by code from verified inputs.",
      "enum": [
        "extract",
        "agent",
        "derive"
      ]
    },
    "claimedValue": {
      "$ref": "urn:atomitron:schema:fact#/$defs/value"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "sourceUrl": {
      "$ref": "urn:atomitron:schema:fact#/$defs/sourceUrl"
    },
    "upstream": {
      "description": "Original contributor the source page credits for the value, e.g. \"IUPAC CIAAW\".",
      "type": "string",
      "minLength": 1
    },
    "retrievedValue": {
      "description": "What the verifier actually found at the source. null if the value could not be found.",
      "anyOf": [
        {
          "$ref": "urn:atomitron:schema:fact#/$defs/value"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "description": "Short excerpt from the source supporting the claim (text facts). Kept brief: a citation, not a copy.",
      "type": "string",
      "maxLength": 400
    },
    "corroboration": {
      "description": "Other contributors or sources whose values agree with the claimed value (methodology section 5), including a NIST WebBook tiebreak.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceUrl",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "sourceUrl": {
            "$ref": "urn:atomitron:schema:fact#/$defs/sourceUrl"
          },
          "upstream": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "tolerance": {
      "description": "Numeric match tolerance applied, per the published methodology. Omit for exact or text matches.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "absolute": {
          "type": "number",
          "minimum": 0
        },
        "relative": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "consistency": {
      "description": "Each check runs several times. Agreement across runs is a confidence signal (spec 10.4b).",
      "type": "object",
      "required": [
        "runs",
        "agreeing"
      ],
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "agreeing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verifier": {
      "description": "Agent and model that ran the check.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
